#include <stdio.h>
void nthPrime()
{
    int N,count=1;
    scanf("%d",&N);
    int i;
    for( i=3;count<N;++i)
    {
        int j;
       for(j=2;j<=(i/2);++j) 
       {
           if(i%j==0)
           {
             break;  
           }
           
       }
        if(j==(i/2)+1)
            count++;   
    }
    printf("%d",i-1);
}
int main() {
   nthPrime();
    return 0;
