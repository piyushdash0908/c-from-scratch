#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

void max(){
    int size;
    scanf("%d",&size);
    int a[size];
    int max;
    
    for(int i=0; i<=size-1; ++i)
    {
        scanf("%d",&a[i]);
        max=a[0];
    }
    
    for(int i=0; i<=size-1; ++i)
    {
        if(a[i]>max)
        {
            max=a[i];
        }
    }
    printf("%d",max);
}

int main() {

    /* Enter your code here. Read input from STDIN. Print output to STDOUT */    
    max();
    return 0;
}
